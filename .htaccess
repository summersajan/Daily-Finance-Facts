RewriteEngine On
RewriteBase /

# --- Pretty Search URLs ---
# /search              -> index.php (will read ?search= from querystring if present)
RewriteRule ^search/?$ index.php [L,QSA]


# --- Articles listing ---
RewriteRule ^articles/?$ articles.php [L,QSA]
# /articles/<slug> -> articles.php?category=<slug>
RewriteRule ^articles/([a-zA-Z0-9_-]+)/?$ articles.php?category=$1 [L,QSA]

# --- Single Article ---
RewriteRule ^article/([a-zA-Z0-9_-]+)/?$ article.php?slug=$1 [L,QSA]

# --- Category page (if you still keep category.php) ---
RewriteRule ^category/([a-zA-Z0-9_-]+)/?$ category.php?category=$1 [L,QSA]

# --- Remove .php extension (fallback) ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^/]+)/?$ $1.php [L,QSA]

# Clean search URLs: /search/ok → /index.php?search=ok
RewriteRule ^search/([^/]+)/?$ index.php?search=$1 [L,QSA]