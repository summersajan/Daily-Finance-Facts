RewriteEngine On
RewriteBase /

# --------------------------------------
# 1. Remove .php extension (index.php → /index)
# --------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]

# --------------------------------------
# 2. Category URLs
#    /category/saving-money → category.php?category=saving-money
# --------------------------------------
RewriteRule ^category/([a-zA-Z0-9_-]+)/?$ category.php?category=$1 [L,QSA]

# --------------------------------------
# 3. Articles listing (all articles)
#    /articles → articles.php
# --------------------------------------
RewriteRule ^articles/?$ articles.php [L,QSA]

# --------------------------------------
# 4. Articles by category
#    /articles/investing → articles.php?category=investing
# --------------------------------------
RewriteRule ^articles/([a-zA-Z0-9_-]+)/?$ articles.php?category=$1 [L,QSA]

# --------------------------------------
# 5. Single Article by slug
#    /article/easy-habits-to-grow-your-savings → article.php?slug=easy-habits-to-grow-your-savings
# --------------------------------------
RewriteRule ^article/([a-zA-Z0-9_-]+)/?$ article.php?slug=$1 [L,QSA]
